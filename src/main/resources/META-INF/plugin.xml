<idea-plugin>
    <id>com.gitlabmr.mrplugin</id>
    <name>GitLabPlus</name>
    <vendor email="cn3shy@qq.com" url="https://github.com/cn3shy/">cn3shy</vendor>

    <description><![CDATA[
        <h3>GitLabPlus</h3>
        <p>在 IntelliJ IDEA 中快速创建 / 查看 GitLab Merge Request。</p>
        <ul>
            <li>自动识别当前项目的 GitLab 远程仓库</li>
            <li>基于源/目标分支差异 commit 自动生成 MR 标题</li>
            <li>支持分支规则校验（主干分支只能作为目标分支）</li>
            <li>记住上次使用的分支和审核人</li>
            <li>下拉选择审核人（自动获取项目成员）</li>
            <li>查看我创建的与指给我的 Merge Request（按 Group 分组展示，可直达页面）</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <b>2026.9.2</b> –
        <ul>
            <li>查看 Merge Request：新增"查询"按钮 (下拉变更不再自动查询)，打开时默认载入上次查询条件；移除状态/范围下拉的"全部"选项</li>
            <li>创建 Merge Request：项目目录未注册 Git 根时也能识别仓库 (从选中目录向上查找 .git)</li>
        </ul>
        <b>2026.9.1</b> – 功能汇总
        <ul>
            <li>创建 Merge Request：自动识别当前项目的 GitLab 远程仓库 (HTTPS / SSH)，按差异 commit 自动生成标题，支持主干分支规则校验、分支 / 审核人记忆与项目成员下拉选择</li>
            <li>查看 Merge Request：按设置页配置的服务器查询我创建的 / 指给我的 MR，按目录 (Group) 分组展示，支持状态 (已打开 / 已合并 / 已关闭 / 全部)、范围 (全部 / 我创建的 / 指给我的) 与目录过滤；已合并只查询前 100 条；双击 / 回车在浏览器打开</li>
            <li>Token 统一在 Settings → Tools → GitLab MR 中管理，本机保存，升级插件 / 重启 IDE 不丢失</li>
            <li>入口统一收进 Git 主菜单 / 新 UI 顶部工具栏 / 项目右键 Git 子菜单的 "GitLabPlus" 子菜单</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
            serviceImplementation="com.gitlabmr.config.GitLabMrConfigService"/>
        <applicationConfigurable
            id="com.gitlabmr.settings"
            parentId="tools"
            displayName="GitLab MR"
            instance="com.gitlabmr.config.GitLabMrSettingsConfigurable"/>
        <notificationGroup id="GitLab MR" displayType="BALLOON"/>
    </extensions>

    <actions>
        <!-- Action 定义一次，通过 add-to-group / reference 挂到不同入口 -->
        <action id="GitLabMr.Create"
                class="com.gitlabmr.action.CreateMrAction"
                icon="/icons/createMr.svg"
                text="创建 Merge Request"
                description="为当前项目创建 GitLab Merge Request">
            <!-- 顶部工具栏只保留"创建 Merge Request"一个按钮，不进分组 -->
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
        </action>

        <action id="GitLabMr.View"
                class="com.gitlabmr.action.ViewMrAction"
                icon="/icons/viewMr.svg"
                text="查看 Merge Request"
                description="查看我创建的与指给我的 GitLab Merge Request"/>

        <!-- Git 主菜单 / 项目右键 Git 子菜单：两个 Action 收进 "GitLabPlus" 子菜单 (图标 createMr.svg) -->
        <group id="GitLabPlus.Group"
               class="com.intellij.openapi.actionSystem.DefaultActionGroup"
               icon="/icons/createMr.svg"
               text="GitLabPlus"
               description="GitLabPlus Merge Request 工具"
               popup="true">
            <!-- 主菜单 Git (VCS) 菜单末尾 -->
            <add-to-group group-id="Git.MainMenu" anchor="last"/>
            <!-- 项目视图右键菜单 → Git 子菜单 -->
            <add-to-group group-id="Git.ContextMenu" anchor="last"/>

            <reference ref="GitLabMr.Create"/>
            <reference ref="GitLabMr.View"/>
        </group>
    </actions>
</idea-plugin>
